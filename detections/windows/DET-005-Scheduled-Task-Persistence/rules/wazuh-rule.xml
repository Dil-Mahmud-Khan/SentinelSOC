<group name="windows,persistence,scheduled_task,custom">

  <!-- Scheduled Task Creation -->

  <rule id="100500" level="10">

    <if_group>sysmon_event1</if_group>

    <field name="win.eventdata.Image" type="pcre2">(?i)schtasks\.exe</field>

    <field name="win.eventdata.CommandLine" type="pcre2">(?i)(/create|-create)</field>

    <description>Possible Scheduled Task persistence created.</description>

    <mitre>
      <id>T1053.005</id>
    </mitre>

    <options>no_full_log</options>

    <group>
      attack,
      persistence,
      scheduled_task,
      windows,
      custom_detection
    </group>

  </rule>

</group>

